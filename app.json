{
  "expo": {
    "name": "ghafra",
    "slug": "ghafra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghafra",
    "userInterfaceStyle": "automatic",

    "updates": {
      "url": "https://u.expo.dev/ad5b2cab-1792-49b3-b6e9-77dac4878ce2"
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow GHAFRA to access your photos.",
        "NSCameraUsageDescription": "Allow GHAFRA to use your camera.",
        "NSUserNotificationUsageDescription": "Allow GHAFRA to send you notifications."
      }
    },

    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GHAFRA to access your photos.",
          "cameraPermission": "Allow GHAFRA to use your camera."
        }
      ],

      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad5b2cab-1792-49b3-b6e9-77dac4878ce2"
      }
    },

    "owner": "hostelhubb"
  }
}