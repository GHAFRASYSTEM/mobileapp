{
  "expo": {
    "name": "ghafra",
    "slug": "ghafra",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghafra",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/ad5b2cab-1792-49b3-b6e9-77dac4878ce2",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.ghafra.ghafra",
       "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow GHAFRA to access your photos.",
        "NSCameraUsageDescription": "Allow GHAFRA to use your camera.",
        "NSUserNotificationUsageDescription": "Allow GHAFRA to send you notifications.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ghafra.ghafra",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
         "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GHAFRA to access your photos.",
          "cameraPermission": "Allow GHAFRA to use your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-build-properties",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "@stripe/stripe-react-native",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad5b2cab-1792-49b3-b6e9-77dac4878ce2"
      }
    },
    "owner": "hostelhubb"
  }
}
